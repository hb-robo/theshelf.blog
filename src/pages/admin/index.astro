---
import { getDB } from '../../db';
import { reviews, events } from '../../db/schema';
import { desc } from 'drizzle-orm';

const db = getDB(Astro.locals.runtime?.env);

// Fetch everything sorted by newest entries first
const allReviews = await db.select().from(reviews).orderBy(desc(reviews.date));
const allEvents = await db.select().from(events).orderBy(desc(events.date));
---

<html>
  <head>
    <title>The Shelf - Admin Panel</title>
    <style>
      body { font-family: system-ui, sans-serif; max-width: 1000px; margin: 40px auto; padding: 0 20px; background: #111; color: #fff; }
      h1, h2 { color: #fff; }
      .actions { margin-bottom: 40px; display: flex; gap: 15px; }
      .btn { background: #0070f3; color: white; padding: 10px 20px; border-radius: 6px; text-decoration: none; font-weight: bold; display: inline-block; }
      .btn.secondary { background: #333; border: 1px solid #444; }
      .btn:hover { opacity: 0.9; }
      table { width: 100%; border-collapse: collapse; margin-top: 15px; background: #1a1a1a; border-radius: 8px; overflow: hidden; }
      th, td { padding: 14px; text-align: left; border-bottom: 1px solid #333; }
      th { background: #222; color: #ccc; }
      tr:hover { background: #222; }
      .badge { padding: 4px 8px; border-radius: 4px; font-size: 12px; font-weight: bold; }
      .badge.published { background: #10b981; color: #fff; }
      .badge.draft { background: #f59e0b; color: #fff; }
    </style>
  </head>
  <body>
    <h1>🗄️ The Shelf CMS Dashboard</h1>
    
    <div class="actions">
      <a href="/admin/new-review" class="btn">✍️ Write New Review</a>
      <a href="/admin/new-event" class="btn secondary">📅 Log New Event</a>
    </div>

    <h2>Existing Reviews</h2>
    <table>
      <thead>
        <tr>
          <th>Title</th>
          <th>Date</th>
          <th>Status</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        {allReviews.map((review) => (
          <tr>
            <td><strong>{review.title}</strong></td>
            <td>{review.date}</td>
            <td>
              <span class={`badge ${review.published ? 'published' : 'draft'}`}>
                {review.published ? 'Published' : 'Draft'}
              </span>
            </td>
            <td>
              <a href={`/admin/edit-review/${review.id}`} class="btn secondary" style="padding: 6px 12px; font-size: 14px;">Edit</a>
            </td>
          </tr>
        ))}
      </tbody>
    </table>
  </body>
</html>

