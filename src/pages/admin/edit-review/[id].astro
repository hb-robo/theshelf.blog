---
import { getDB } from "@db/db";
import { reviews, mediaItems } from "@db/schema";
import { eq } from "drizzle-orm";

// Generate static paths at build time
export async function getStaticPaths() {
  const db = getDB(process.env);

  const allReviews = await db.select({ id: reviews.id }).from(reviews);

  return allReviews.map((review) => ({
    params: { id: review.id },
  }));
}

const { id } = Astro.params;
const db = getDB(Astro.locals.runtime?.env);

// Fetch data for the specific pre-rendered page
const existingReview = await db
  .select()
  .from(reviews)
  .where(eq(reviews.id, id))
  .get();

const existingMedia = await db
  .select()
  .from(mediaItems)
  .orderBy(mediaItems.title);

if (!existingReview) return Astro.redirect("/admin");
---

<html>
  <head>
    <title>Edit: {existingReview.title}</title>
    <style>
      body {
        font-family: system-ui, sans-serif;
        max-width: 800px;
        margin: 40px auto;
        padding: 0 20px;
        background: #111;
        color: #fff;
      }
      label {
        display: block;
        margin: 20px 0 5px;
        font-weight: bold;
        color: #ccc;
      }
      input,
      select,
      textarea {
        width: 100%;
        padding: 12px;
        border-radius: 6px;
        border: 1px solid #444;
        background: #222;
        color: #fff;
        box-sizing: border-box;
        font-size: 16px;
      }
      textarea {
        height: 400px;
        font-family: monospace;
      }
      .actions {
        display: flex;
        gap: 15px;
        margin-top: 25px;
      }
      button {
        background: #10b981;
        color: white;
        padding: 12px 24px;
        border: none;
        border-radius: 6px;
        font-size: 16px;
        cursor: pointer;
        font-weight: bold;
      }
      button:hover {
        background: #059669;
      }
      .cancel {
        background: #333;
        color: #ccc;
        border: 1px solid #444;
        padding: 12px 24px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 16px;
        text-align: center;
      }
    </style>
  </head>
  <body>
    <h1>✏️ Edit Review: "{existingReview.title}"</h1>
    <form method="POST">
      <label for="mediaId">Linked Master Media Item</label>
      <select name="mediaId" required>
        {
          existingMedia.map((media) => (
            <option
              value={media.id}
              selected={media.id === existingReview.mediaId}
            >
              {media.title} ({media.mediaType})
            </option>
          ))
        }
      </select>

      <label for="title">Review Title</label>
      <input type="text" name="title" value={existingReview.title} required />

      <label for="excerpt">Brief Excerpt</label>
      <input
        type="text"
        name="excerpt"
        value={existingReview.excerpt || ""}
        placeholder="Catchy summary hook..."
      />

      <label for="body">Content Body (Markdown)</label>
      <textarea name="body" required>{existingReview.body}</textarea>

      <label for="published">Status</label>
      <select name="published">
        <option value="false" selected={!existingReview.published}>Draft</option
        >
        <option value="true" selected={existingReview.published}
          >Published / Live</option
        >
      </select>

      <div class="actions">
        <button type="submit">Update Changes</button>
        <a href="/admin" class="cancel">Cancel</a>
      </div>
    </form>
  </body>
</html>
